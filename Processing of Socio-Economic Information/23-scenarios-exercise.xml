<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet" xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"><Worksheet ss:Name="Бюджет"><Table><Row><Cell><Data ss:Type="String">Показател</Data></Cell><Cell><Data ss:Type="String">Стойност</Data></Cell></Row><Row><Cell><Data ss:Type="String">Цена на билет</Data></Cell><Cell><Data ss:Type="Number">18</Data></Cell></Row><Row><Cell><Data ss:Type="String">Посетители</Data></Cell><Cell><Data ss:Type="Number">500</Data></Cell></Row><Row><Cell><Data ss:Type="String">Разход на посетител</Data></Cell><Cell><Data ss:Type="Number">5</Data></Cell></Row><Row><Cell><Data ss:Type="String">Фиксирани разходи</Data></Cell><Cell><Data ss:Type="Number">3500</Data></Cell></Row><Row><Cell><Data ss:Type="String">Приход</Data></Cell><Cell><Data ss:Type="String">=B2*B3</Data></Cell></Row><Row><Cell><Data ss:Type="String">Общ разход</Data></Cell><Cell><Data ss:Type="String">=B3*B4+B5</Data></Cell></Row><Row><Cell><Data ss:Type="String">Резултат</Data></Cell><Cell><Data ss:Type="String">=B6-B7</Data></Cell></Row></Table></Worksheet><Worksheet ss:Name="Задачи"><Table><Row><Cell><Data ss:Type="String">№</Data></Cell><Cell><Data ss:Type="String">Задача</Data></Cell></Row><Row><Cell><Data ss:Type="Number">1</Data></Cell><Cell><Data ss:Type="String">Създайте сценарии за 400, 500 и 650 посетители.</Data></Cell></Row><Row><Cell><Data ss:Type="Number">2</Data></Cell><Cell><Data ss:Type="String">Добавете вариант с цена на билет 20 лв.</Data></Cell></Row><Row><Cell><Data ss:Type="Number">3</Data></Cell><Cell><Data ss:Type="String">Добавете вариант с разход на посетител 6 лв.</Data></Cell></Row><Row><Cell><Data ss:Type="Number">4</Data></Cell><Cell><Data ss:Type="String">Сравнете резултата при всички сценарии.</Data></Cell></Row><Row><Cell><Data ss:Type="Number">5</Data></Cell><Cell><Data ss:Type="String">Намерете сценарий с положителен резултат над 3000 лв.</Data></Cell></Row><Row><Cell><Data ss:Type="Number">6</Data></Cell><Cell><Data ss:Type="String">Променете един сценарий и проверете как се променя резултатът.</Data></Cell></Row><Row><Cell><Data ss:Type="Number">7</Data></Cell><Cell><Data ss:Type="String">Подгответе кратка препоръка кой вариант да се избере.</Data></Cell></Row></Table></Worksheet></Workbook>