<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet" xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"><Worksheet ss:Name="Обекти"><Table><Row><Cell><Data ss:Type="String">Обект</Data></Cell><Cell><Data ss:Type="String">Регион</Data></Cell><Cell><Data ss:Type="String">Приход</Data></Cell><Cell><Data ss:Type="String">Разход</Data></Cell><Cell><Data ss:Type="String">Клиенти</Data></Cell><Cell><Data ss:Type="String">Оценка</Data></Cell><Cell><Data ss:Type="String">Риск</Data></Cell><Cell><Data ss:Type="String">Решение</Data></Cell></Row><Row><Cell><Data ss:Type="String">Магазин A</Data></Cell><Cell><Data ss:Type="String">Запад</Data></Cell><Cell><Data ss:Type="Number">125000</Data></Cell><Cell><Data ss:Type="Number">98000</Data></Cell><Cell><Data ss:Type="Number">1400</Data></Cell><Cell><Data ss:Type="Number">4.6</Data></Cell><Cell><Data ss:Type="String">Среден</Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row><Row><Cell><Data ss:Type="String">Магазин B</Data></Cell><Cell><Data ss:Type="String">Изток</Data></Cell><Cell><Data ss:Type="Number">108000</Data></Cell><Cell><Data ss:Type="Number">95000</Data></Cell><Cell><Data ss:Type="Number">1100</Data></Cell><Cell><Data ss:Type="Number">4.2</Data></Cell><Cell><Data ss:Type="String">Нисък</Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row><Row><Cell><Data ss:Type="String">Магазин C</Data></Cell><Cell><Data ss:Type="String">Юг</Data></Cell><Cell><Data ss:Type="Number">138000</Data></Cell><Cell><Data ss:Type="Number">121000</Data></Cell><Cell><Data ss:Type="Number">1600</Data></Cell><Cell><Data ss:Type="Number">4.8</Data></Cell><Cell><Data ss:Type="String">Среден</Data></Cell><Cell><Data ss:Type="String"></Data></Cell></Row><Row><Cell><Data ss:Type="String">Магазин D</Data></Cell><Cell><Data ss:Type="String">Запад</Data></Cell><Cell><Data ss:Type="Number">92000</Data></Cell><Cell><Data ss:Type="Number">88000</Data></Cell><Cell><Data ss:Type="Number">900</Data></Cell><Cell><Data ss:Type="